#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [ ! -f composer.json ]; then
  exit 0
fi

policy_console="${ASSEGAI_RELEASE_CONSOLE:?Set ASSEGAI_RELEASE_CONSOLE to the reviewed Console policy checkout.}"
policy_core="${ASSEGAI_RELEASE_CORE:?Set ASSEGAI_RELEASE_CORE to the reviewed Core data checkout.}"
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [ "$local_sha" != "$(git rev-parse HEAD)" ] || ! git diff --quiet "$local_sha" -- composer.json; then
    printf '%s\n' 'Check out the pushed source and commit its Composer manifest before running the policy check.' >&2
    exit 1
  fi
  php "$policy_console/tools/release-check.php" \
    --mode=consumer --format=json \
    --console-root="$policy_console" --console-ref=65750afa2bc4123e71151ba24b3798337c0a3de7 \
    --core-root="$policy_core" --core-ref=9a405927081cf3573faa38b9b87239c21707fae8 \
    --inventory="$policy_core/meta/releases/0.11.json" \
    --modules="$policy_core/meta/framework-modules.json" \
    --manifest="$repo_root/composer.json" \
    --semver-autoload="$policy_console/tools/policy/vendor/autoload.php" \
    --ref="$remote_ref"
done


has_composer_script() {
  php -r '
    $composer = json_decode(file_get_contents("composer.json"), true);
    exit(isset($composer["scripts"][$argv[1]]) ? 0 : 1);
  ' "$1"
}

run_composer_script() {
  local script="$1"

  if has_composer_script "$script"; then
    printf "\n==> composer %s\n" "$script"
    composer "$script"
  fi
}

run_composer_script analyze
run_composer_script test
