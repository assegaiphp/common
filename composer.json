{
    "name": "assegaiphp/common",
    "description": "Shared HTTP, logging, path, exception, and queue primitives for AssegaiPHP packages.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Assegai\\Common\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "andrew.masiye@assegaiphp.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^7.5",
        "assegaiphp/attributes": "^1.0",
        "symfony/console": "^8.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.4"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
